params:
  cutoff = 1000.0 {20.0, 20000.0}
  q = 0.707107 {0.01, 4.0}
  mode = 0 {0, 2}

init:
  z1 = 0.0
  z2 = 0.0

block:
  frequency = min(cutoff, SR * 0.48)
  f = tan(PI * frequency / SR)
  invQ = 1.0 / q
  d = 1.0 / (1.0 + invQ * f + f * f)
  a = f
  g1 = f + invQ

  sample:
    high = (in1 - g1 * z1 - z2) * d
    band = a * high + z1
    low = a * band + z2

    z1 = a * high + band
    z2 = a * band + low

    if mode == 0:
      out1 = low
    elif mode == 1:
      out1 = high
    else:
      out1 = band
