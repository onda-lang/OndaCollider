const Timestep = 0.001

params:
  rho = 28.0 {0.0, 50.0}
  sigma = 10.0 {0.0, 20.0}
  beta = 2.666 {0.0, 10.0}
  speed = 20 {1, 200}

init:
  x = 0.1
  y = 0.0
  z = 0.0

sample:
  loop speed:
    dx = sigma * (y - x)
    dy = x * (rho - z) - y
    dz = x * y - beta * z

    x += dx * Timestep
    y += dy * Timestep
    z += dz * Timestep

  out1 = x * 0.03
  out2 = y * 0.03
