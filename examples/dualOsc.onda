import std/osc

proc DualOsc<T>:
  params<T>:
    freq = 110.0
    modDepth = 1.5
    detune = 1.0

  outs<T> 2

  init<T>:
    oscA = std::osc::Sine<T>()
    oscB = std::osc::Sine<T>()
    lastA = 0.0
    lastB = 0.0

  sample 8:
    currentA = oscA(freq = freq, phase_offset = lastB * modDepth)
    currentB = oscB(freq = freq + detune, phase_offset = lastA * modDepth)
    lastA = currentA
    lastB = currentB
    out1 = currentA
    out2 = currentB

params:
  freq = 110.0 {20.0, 1000.0}
  modDepth = 1.5 {0.0, 20.0}
  detune = 1.0 {0.0, 100.0}

init:
  osc = DualOsc<f64>()

sample:
  osc1, osc2 = osc(freq = freq, modDepth = modDepth, detune = detune)
  out1 = f32(osc1)
  out2 = f32(osc2)
