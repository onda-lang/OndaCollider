import std/osc

proc DualOsc:
  params:
    freq = 110.0
    modDepth = 1.5
    detune = 1.0

  outs 2

  init:
    oscA = std::osc::Sine()
    oscB = std::osc::Sine()
    lastA = 0.0
    lastB = 0.0

  sample 8:
    currentA = oscA(freq = freq, phase_offset = lastB * modDepth)
    currentB = oscB(freq = freq + detune, phase_offset = lastA * modDepth)
    lastA = currentA
    lastB = currentB
    out1 = currentA
    out2 = currentB

params:
  freq = 110.0 {20.0, 1000.0}
  modDepth = 1.5 {0.0, 20.0}
  detune = 1.0 {0.0, 100.0}

init:
  osc = DualOsc()

sample:
  osc1, osc2 = osc(freq = freq, modDepth = modDepth, detune = detune)
  out1 = osc1
  out2 = osc2
