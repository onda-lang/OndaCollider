cmake_minimum_required(VERSION 3.18)

foreach(required IN ITEMS ARTIFACT_DIR DESTINATION SOURCE_REVISION SDK_TARGET)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${required}")
    endif()
endforeach()
if(EXISTS "${DESTINATION}")
    message(FATAL_ERROR "SDK destination already exists: ${DESTINATION}")
endif()

file(READ "${ARTIFACT_DIR}/onda-source.txt" artifact_source)
string(STRIP "${artifact_source}" artifact_source)
if(NOT artifact_source STREQUAL SOURCE_REVISION)
    message(FATAL_ERROR "SDK artifact source does not match ${SOURCE_REVISION}")
endif()

file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/../onda-version" version LIMIT_COUNT 1)
string(STRIP "${version}" version)
set(sdk_name "onda-${version}-${SDK_TARGET}")
set(extension tar.xz)
set(static_library libonda.a)
if(SDK_TARGET STREQUAL "windows-x64")
    set(extension zip)
    set(static_library onda.lib)
elseif(NOT SDK_TARGET MATCHES "^(linux-x64|macos-arm64)$")
    message(FATAL_ERROR "Unsupported SDK target: ${SDK_TARGET}")
endif()
set(archive_name "${sdk_name}.${extension}")
set(archive "${ARTIFACT_DIR}/${archive_name}")

file(STRINGS "${ARTIFACT_DIR}/SHA256SUMS.txt" checksum_lines)
set(expected_sha256 "")
foreach(line IN LISTS checksum_lines)
    if(line MATCHES "^([0-9a-fA-F]+) [ *](.+)$")
        if(CMAKE_MATCH_2 STREQUAL archive_name)
            if(NOT expected_sha256 STREQUAL "")
                message(FATAL_ERROR "Duplicate checksum for ${archive_name}")
            endif()
            string(TOLOWER "${CMAKE_MATCH_1}" expected_sha256)
        endif()
    endif()
endforeach()
string(LENGTH "${expected_sha256}" checksum_length)
if(NOT checksum_length EQUAL 64)
    message(FATAL_ERROR "Missing or invalid SHA-256 checksum for ${archive_name}")
endif()
file(SHA256 "${archive}" actual_sha256)
if(NOT actual_sha256 STREQUAL expected_sha256)
    message(FATAL_ERROR "SDK archive checksum mismatch: ${archive_name}")
endif()

set(staging "${DESTINATION}.unpacked")
set(extracted "${staging}/${sdk_name}")
file(REMOVE_RECURSE "${staging}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${staging}")
foreach(required IN ITEMS include/onda.h lib/${static_library} lib/cmake/Onda/OndaConfig.cmake)
    if(NOT EXISTS "${extracted}/${required}")
        message(FATAL_ERROR "SDK archive is missing ${required}")
    endif()
endforeach()
file(RENAME "${extracted}" "${DESTINATION}")
file(REMOVE_RECURSE "${staging}")
file(WRITE "${DESTINATION}/.onda-version" "${version}\n")
file(WRITE "${DESTINATION}/.onda-source" "${artifact_source}\n")
message(STATUS "Verified Onda ${version} SDK for ${SDK_TARGET} from ${artifact_source}")
